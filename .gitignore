# Build output (CMake, Visual Studio, Xcode, Ninja) and the installers
build/
build-*/
out/
_deps/
dist/
site/
.vs/
.vscode/
.idea/
.cache/
*.user
CMakeUserPresets.json
compile_commands.json
# generated by packaging/make_iss_include.ps1 (local paths)
packaging/plugins.iss.inc
# The local check's build log
build.log

# Python
__pycache__/
*.pyc
.venv/

# Generated test renders (re-render with FL Studio, see plugin/nulltest/README.md)
**/nulltest/renders/
**/nulltest/renders_fl/
**/nulltest/ours/
**/nulltest/probe/
# Files FL wrote (projects, the wrapper chunk): local only
**/nulltest/local/

# Audio is never committed. Test signals are generated (python plugin/nulltest/render_signals.py;
# python render_stretch_signals.py and probe_env_time.py in the same folder); FL's renders stay local.
*.wav

# The originals' captures, renders and extracted material never enter the repository
reference/
**/nulltest/results*.json

# FL demo samples copied in by plugin/nulltest/cases_untested.py
**/nulltest/fmt_test.*
**/nulltest/fst/

# Signing material never enters the repository (it lives in GitHub's Actions secrets)
*.p12
*.pfx
*.p8
*.cer
*.mobileprovision

# Machine paths: local.example.yaml lists the keys
local.yaml

# OS files
.DS_Store
Thumbs.db

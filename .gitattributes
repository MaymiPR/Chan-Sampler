# Text files are stored and checked out with LF line endings on every
# platform; the Windows installer script and install notes keep CRLF.
* text=auto eol=lf
*.iss text eol=crlf
packaging/INSTALL-Windows.txt text eol=crlf

# Binary data
*.wav binary
*.npy binary
*.png binary
*.flp binary
*.fst binary
*.pkl binary
